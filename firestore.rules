// SETUP_BLOCKED: This source cannot be published until access rules and the
// offline sync client pass review, emulator tests, and a two-device trial.
// It intentionally denies all client access while the project is configured.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
